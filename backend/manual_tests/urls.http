@baseUrl = http://localhost:3003/v1

### create a url + NULLS
POST {{baseUrl}}/urls
Content-Type: application/json

{
	"raw_url": "https://example.com"
}

### create a url with title + notes (COMPLET)
POST {{baseUrl}}/urls
Content-Type: application/json

{
	"raw_url": "https://google.com",
	"title": "Example",
	"notes": "just a test"
}

### list all urls
GET {{baseUrl}}/urls/all

### update a url (replace 1 with a real id)
PATCH {{baseUrl}}/urls/1
Content-Type: application/json

{
	"title": "new title"
}

### empty patch -> 400
PATCH {{baseUrl}}/urls/1
Content-Type: application/json

{}

### delete a url (replace 1 with a real id)
DELETE {{baseUrl}}/urls/1
