// writes the typed client into our own source code, not node_modules
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// url lives in prisma.config.ts, not here (Prisma 7)
datasource db {
  provider = "postgresql"
}

model urls {
  id         Int          @id @default(autoincrement())
  raw_url    String
  short_code String       @unique
  title      String?
  notes      String?
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime     @updatedAt @db.Timestamptz(6)
  url_clicks url_clicks[]

  @@index([raw_url])
}

model tags {
  id    Int    @id @default(autoincrement())
  name  String @unique
  color String @default("#808080")
}

model folders {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)
}

model url_clicks {
  id         Int      @id @default(autoincrement())
  url_id     Int
  clicked_at DateTime @default(now()) @db.Timestamptz(6)
  urls       urls     @relation(fields: [url_id], references: [id], onDelete: Cascade)

  @@index([url_id, clicked_at])
}
