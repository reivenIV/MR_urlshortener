// writes the typed client into our own source code, not node_modules
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// url lives in prisma.config.ts, not here (Prisma 7)
datasource db {
  provider = "postgresql"
}

model urls {
  id         BigInt   @id @default(autoincrement())
  raw_url    String
  short_code String   @unique
  title      String?
  notes      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([raw_url])
}
